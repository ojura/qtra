{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Optimized Qt runtime-agent demo",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PATCH_READY": "ON"
      }
    },
    {
      "name": "release-lto",
      "displayName": "Optimized Qt runtime-agent demo with LTO",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-lto",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "PATCH_READY": "ON"
      }
    },
    {
      "name": "release-cet",
      "displayName": "Optimized Qt runtime-agent demo with Intel CET",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-cet",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_CET": "ON",
        "PATCH_READY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-lto",
      "configurePreset": "release-lto"
    },
    {
      "name": "release-cet",
      "configurePreset": "release-cet"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-lto",
      "configurePreset": "release-lto",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-cet",
      "configurePreset": "release-cet",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}